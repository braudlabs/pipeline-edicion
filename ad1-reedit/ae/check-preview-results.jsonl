mber","required":false,"description":"Width in px (default: keep)"},{"name":"height","type":"number","required":false,"description":"Height in px (default: keep)"}]},{"name":"footage.replace_with_placeholder","description":"Replace a footage item's source with a placeholder (FootageItem.replaceWithPlaceholder) — e.g. to stand in for footage that will arrive later. Layers keep keyframes/effects.","readOnly":false,"params":[{"name":"item","type":"any","required":true,"description":"Footage item id (number) or name (string)"},{"name":"name","type":"string","required":false,"description":"Placeholder name"},{"name":"width","type":"number","required":false,"description":"Width in px (default: keep)"},{"name":"height","type":"number","required":false,"description":"Height in px (default: keep)"},{"name":"frameRate","type":"number","required":false,"description":"Frame rate (default 30)","default":30},{"name":"duration","type":"number","required":false,"description":"Duration in seconds (default: keep, or 1)"}]},{"name":"footage.set_proxy","description":"Set or clear a proxy on any project item (comp or footage): a file, an image sequence, a solid color, or a placeholder. Omit path/solidColor/placeholder to remove the proxy.","readOnly":false,"params":[{"name":"item","type":"any","required":true,"description":"Project item id (number) or name (string)"},{"name":"path","type":"string","required":false,"description":"Absolute path to the proxy file — omit to remove the proxy","nullable":true},{"name":"sequence","type":"boolean","required":false,"description":"Treat path as the first file of an image sequence (default false)"},{"name":"solidColor","type":"array","required":false,"description":"[r,g,b] 0-1 — set a solid proxy instead of a file (setProxyWithSolid)"},{"name":"placeholder","type":"boolean","required":false,"description":"Set a placeholder proxy sized like the item (setProxyWithPlaceholder)"}]}]},"isError":false}}
