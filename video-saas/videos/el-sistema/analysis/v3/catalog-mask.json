{
  "ok": true,
  "category": "mask",
  "operations": [
    {
      "name": "mask.add",
      "description": "Add a new mask to a layer. Returns the mask index.",
      "readOnly": false,
      "params": [
        {
          "name": "comp",
          "type": "any",
          "required": true,
          "description": "Comp name or id"
        },
        {
          "name": "layer",
          "type": "any",
          "required": true,
          "description": "1-based layer index, or the layer name"
        },
        {
          "name": "name",
          "type": "string",
          "required": false,
          "description": "Mask name"
        }
      ]
    },
    {
      "name": "mask.set_path",
      "description": "Set a mask's shape path from vertices. Vertices are [x,y] pairs relative to the layer.",
      "readOnly": false,
      "params": [
        {
          "name": "comp",
          "type": "any",
          "required": true,
          "description": "Comp name or id"
        },
        {
          "name": "layer",
          "type": "any",
          "required": true,
          "description": "1-based layer index, or the layer name"
        },
        {
          "name": "maskIndex",
          "type": "number",
          "required": true,
          "description": "1-based mask index"
        },
        {
          "name": "vertices",
          "type": "array",
          "required": true,
          "description": "Array of [x,y] points"
        },
        {
          "name": "inTangents",
          "type": "array",
          "required": false,
          "description": "Array of [x,y] in-tangent offsets (same length as vertices)"
        },
        {
          "name": "outTangents",
          "type": "array",
          "required": false,
          "description": "Array of [x,y] out-tangent offsets"
        },
        {
          "name": "closed",
          "type": "boolean",
          "required": false,
          "description": "Close the path (default true)",
          "default": true
        },
        {
          "name": "featherSegLocs",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: 0-based segment index per feather point"
        },
        {
          "name": "featherRelSegLocs",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: relative position (0-1) on the segment, per point"
        },
        {
          "name": "featherRadii",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: radius in px per point. Sign must match featherTypes: outer points (type 0) need radius >= 0, inner points (type 1) need radius <= 0 \u2014 AE rejects mismatches"
        },
        {
          "name": "featherInterps",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: 0=smooth, 1=hold, per point (default all 0)"
        },
        {
          "name": "featherTensions",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: tension 0-1 per point (default all 0)"
        },
        {
          "name": "featherTypes",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: 0=outer, 1=inner, per point (default all 0)"
        },
        {
          "name": "featherRelCornerAngles",
          "type": "array",
          "required": false,
          "description": "Variable-width feather: relative corner angle % per point (default all 0)"
        }
      ]
    },
    {
      "name": "mask.set_props",
      "description": "Set mask properties: mode, feather, opacity, expansion, inverted, locked, color, rotoBezier, motionBlur, featherFalloff.",
      "readOnly": false,
      "params": [
        {
          "name": "comp",
          "type": "any",
          "required": true,
          "description": "Comp name or id"
        },
        {
          "name": "layer",
          "type": "any",
          "required": true,
          "description": "1-based layer index, or the layer name"
        },
        {
          "name": "maskIndex",
          "type": "number",
          "required": true,
          "description": "1-based mask index"
        },
        {
          "name": "mode",
          "type": "string",
          "required": false,
          "description": "Add|Subtract|Intersect|Lighten|Darken|Difference|None"
        },
        {
          "name": "feather",
          "type": "array",
          "required": false,
          "description": "[x,y] feather in px"
        },
        {
          "name": "opacity",
          "type": "number",
          "required": false,
          "description": "Mask opacity 0-100"
        },
        {
          "name": "expansion",
          "type": "number",
          "required": false,
          "description": "Mask expansion in px"
        },
        {
          "name": "inverted",
          "type": "boolean",
          "required": false,
          "description": "Invert the mask"
        },
        {
          "name": "locked",
          "type": "boolean",
          "required": false,
          "description": "Lock the mask against UI editing"
        },
        {
          "name": "color",
          "type": "array",
          "required": false,
          "description": "[r,g,b] 0-1 mask outline color in the UI"
        },
        {
          "name": "rotoBezier",
          "type": "boolean",
          "required": false,
          "description": "Treat the path as a RotoBezier (tangents auto-computed)"
        },
        {
          "name": "motionBlur",
          "type": "string",
          "required": false,
          "description": "sameAsLayer|on|off (per-mask motion blur)"
        },
        {
          "name": "featherFalloff",
          "type": "string",
          "required": false,
          "description": "smooth|linear (feather falloff)"
        }
      ]
    },
    {
      "name": "mask.remove",
      "description": "Remove a mask from a layer by its 1-based index.",
      "readOnly": false,
      "params": [
        {
          "name": "comp",
          "type": "any",
          "required": true,
          "description": "Comp name or id"
        },
        {
          "name": "layer",
          "type": "any",
          "required": true,
          "description": "1-based layer index, or the layer name"
        },
        {
          "name": "maskIndex",
          "type": "number",
          "required": true,
          "description": "1-based mask index"
        }
      ]
    }
  ]
}