    {
      "name": "text.set_box",
      "description": "Resize, reposition, or configure the box of a paragraph (box) text layer, including the AE 24.6 auto-fit and alignment controls. Point<->box conversion is NOT scriptable in AE \u2014 create the layer as box text from the start (layer.create_text with boxSize).",
      "readOnly": false,
      "params": [
        {
          "name": "comp",
          "type": "any",
          "required": true,
          "description": "Comp name or id"
        },
        {
          "name": "layer",
          "type": "any",
          "required": true,
          "description": "1-based layer index, or the layer name"
        },
        {
          "name": "boxSize",
          "type": "array",
          "required": false,
          "description": "[width, height] of the text box"
        },
        {
          "name": "boxPosition",
          "type": "array",
          "required": false,
          "description": "[x, y] top-left of the box in layer space (AE 14.0+)"
        },
        {
          "name": "autoFitPolicy",
          "type": "string",
          "required": false,
          "description": "none|heightCursor|heightPreciseBounds|heightBaseline (AE 24.6+)"
        },
        {
          "name": "verticalAlignment",
          "type": "string",
          "required": false,
          "description": "top|center|bottom|justify (AE 24.6+)"
        },
        {
          "name": "firstBaselineAlignment",
          "type": "string",
          "required": false,
          "description": "ascent|capHeight|emBox|leading|xHeight|legacyMetric|minimumValueAsian|minimumValueRoman|typoAscent (AE 24.6+)"
        },
        {
          "name": "firstBaselineAlignmentMinimum",
          "type": "number",
          "required": false,
          "description": "Manual minimum offset of the first composed line (AE 24.6+)"
