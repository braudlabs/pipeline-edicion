        },
        {
          "name": "axisTag",
          "type": "string",
          "required": true,
          "description": "Four-character axis tag, e.g. 'wght'"
        },
        {
          "name": "animator",
          "type": "any",
          "required": false,
          "description": "Existing animator (1-based index or name). Omit to create a new animator."
